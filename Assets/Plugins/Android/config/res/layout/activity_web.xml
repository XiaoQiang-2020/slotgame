<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical" >

    <RelativeLayout android:id="@+id/web_relate_layout"
		android:layout_width="match_parent"
    	android:layout_height="wrap_content">
    
	<ImageButton android:id="@+id/to_back"
	    android:layout_width="wrap_content"
	    android:layout_height="wrap_content"
	    android:layout_alignParentLeft="true"
	    android:src= "@drawable/web_img_back"
	    android:onClick="onBack"
	    />
	<ImageButton android:id="@+id/to_forward"
	    android:layout_width="wrap_content"
	    android:layout_height="wrap_content"
	    android:src= "@drawable/web_img_forward"
	    android:layout_toRightOf="@id/to_back"
	    android:onClick="onForward"
	    />
	<ImageButton  android:id="@+id/to_close"
	    android:layout_width="wrap_content"
	    android:layout_height="wrap_content"
	    android:src= "@drawable/web_img_close"
	    android:layout_alignParentRight="true"
	    android:onClick="onClose"
	    />
    </RelativeLayout>

    <FrameLayout
    android:id="@+id/myWebFrame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
	android:layout_gravity="center_horizontal"
    android:layout_weight="0.08" />

</LinearLayout>